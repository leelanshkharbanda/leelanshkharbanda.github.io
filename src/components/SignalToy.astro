<div class="signal-toy" data-signal-toy data-pulse="idle">
  <div class="signal-toy__topline">
    <span>01 / CHANNEL SKETCHPAD</span>
    <span class="signal-toy__drag-label" hidden>
      DRAG IN 2D
    </span>
    <span
      class="signal-toy__pulse-indicator"
      data-toy-pulse-indicator
      data-state="idle"
      aria-hidden="true"
    >
      READY
    </span>
  </div>
  <p id="signal-toy-keyboard-help" class="sr-only" hidden>
    Use Left/Right for X and Up/Down for Y. Home and End jump to the minimum and maximum.
  </p>

  <svg
    class="signal-toy__svg"
    viewBox="0 0 480 270"
    role="group"
    aria-labelledby="signal-toy-title signal-toy-description"
  >
    <title id="signal-toy-title">A tiny signal-path sketch</title>
    <desc id="signal-toy-description">
      A transmitter and receiver compare a direct path with a reflected path. This is an original
      visual sketch, not Chronos-DSP data or a physical radio measurement.
    </desc>
    <defs>
      <pattern id="signal-toy-grid" width="24" height="24" patternUnits="userSpaceOnUse">
        <path d="M 24 0 L 0 0 0 24" fill="none" stroke="#45483d" stroke-width="1" />
      </pattern>
      <marker
        id="signal-toy-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#dfff68" />
      </marker>
    </defs>

    <rect width="480" height="270" fill="#20231c" />
    <rect width="480" height="270" fill="url(#signal-toy-grid)" />
    <g class="signal-toy__legend" aria-hidden="true">
      <circle cx="18" cy="18" r="4" fill="#dfff68" />
      <text x="30" y="22" class="signal-toy__svg-label">
        TX / SOURCE
      </text>
      <circle cx="160" cy="18" r="4" fill="#ff785a" />
      <text x="172" y="22" class="signal-toy__svg-label">
        RX / RECEIVER
      </text>
    </g>
    <path d="M 28 218 L 452 218" stroke="#f5f1e6" stroke-width="8" />
    <path d="M 28 218 L 452 218" stroke="#ff785a" stroke-width="2" stroke-dasharray="5 7" />
    <text x="30" y="244" class="signal-toy__svg-label">
      REFLECTING WALL
    </text>
    <text x="450" y="244" text-anchor="end" class="signal-toy__svg-label">
      2D PATHS
    </text>

    <path
      data-signal-path="direct"
      d="M 104 104 L 370 82"
      fill="none"
      stroke="#dfff68"
      stroke-width="3"
      marker-end="url(#signal-toy-arrow)"
    />
    <path
      data-signal-path="echo"
      d="M 104 104 L 225.3 218 L 370 82"
      fill="none"
      stroke="#ff785a"
      stroke-width="2"
      stroke-dasharray="7 6"
      marker-end="url(#signal-toy-arrow)"
    />
    <circle data-signal-bounce cx="225.3" cy="218" r="5" fill="#ff785a" />

    <g class="signal-toy__pulse" data-signal-pulse="direct" aria-hidden="true">
      <circle
        class="signal-toy__pulse-dot signal-toy__pulse-dot--trail"
        data-pulse-offset="14"
        r="2.5"
      />
      <circle
        class="signal-toy__pulse-dot signal-toy__pulse-dot--mid"
        data-pulse-offset="7"
        r="3.5"
      />
      <circle
        class="signal-toy__pulse-dot signal-toy__pulse-dot--core"
        data-pulse-offset="0"
        r="4.5"
      />
    </g>
    <g class="signal-toy__pulse" data-signal-pulse="echo" aria-hidden="true">
      <circle
        class="signal-toy__pulse-dot signal-toy__pulse-dot--trail"
        data-pulse-offset="14"
        r="2.5"
      />
      <circle
        class="signal-toy__pulse-dot signal-toy__pulse-dot--mid"
        data-pulse-offset="7"
        r="3.5"
      />
      <circle
        class="signal-toy__pulse-dot signal-toy__pulse-dot--core"
        data-pulse-offset="0"
        r="4.5"
      />
    </g>

    <g
      class="signal-toy__handle"
      aria-hidden="true"
      data-signal-handle="transmitter"
      data-x="104"
      data-y="104"
      transform="translate(104 104)"
    >
      <circle r="25" fill="#dfff68" fill-opacity="0.15" />
      <circle r="15" fill="#dfff68" stroke="#20231c" stroke-width="3" />
      <circle r="4" fill="#20231c" />
      <text y="43" text-anchor="middle" class="signal-toy__handle-label">
        TX / SOURCE
      </text>
      <circle class="signal-toy__hit-area" r="48" />
    </g>

    <g
      class="signal-toy__handle"
      aria-hidden="true"
      data-signal-handle="receiver"
      data-x="370"
      data-y="82"
      transform="translate(370 82)"
    >
      <circle r="25" fill="#ff785a" fill-opacity="0.15" />
      <circle r="15" fill="#ff785a" stroke="#20231c" stroke-width="3" />
      <circle r="4" fill="#20231c" />
      <circle class="signal-toy__receiver-ring" r="25" />
      <text y="43" text-anchor="middle" class="signal-toy__handle-label">
        RX / RECEIVER
      </text>
      <circle class="signal-toy__hit-area" r="48" />
    </g>
  </svg>

  <div class="signal-toy__readouts">
    <p>
      <span>DIRECT PATH</span>
      <strong data-toy-direct>267 units</strong>
    </p>
    <p>
      <span>REFLECTED PATH</span>
      <strong data-toy-echo>365 units</strong>
    </p>
    <span class="signal-toy__readout-note signal-toy__interactive-note" hidden>
      Drag in 2D, fine-tune with X/Y, or send a pulse through both paths.
    </span>
    <noscript>
      <span class="signal-toy__readout-note">Fixed direct and reflected path lengths.</span>
    </noscript>
  </div>

  <div class="signal-toy__controls" id="signal-toy-instructions" hidden>
    <div class="signal-toy__axis-controls">
      <div class="signal-toy__axis-group" role="group" aria-label="Transmitter position controls">
        <span class="signal-toy__axis-title">Transmitter</span>
        <label>
          <span>X</span>
          <input
            data-toy-range="transmitter"
            aria-label="Transmitter X"
            aria-describedby="signal-toy-keyboard-help"
            type="range"
            min="48"
            max="432"
            value="104"
          />
        </label>
        <label>
          <span>Y</span>
          <input
            data-toy-range-y="transmitter"
            aria-label="Transmitter Y"
            aria-describedby="signal-toy-keyboard-help"
            type="range"
            min="54"
            max="166"
            value="104"
          />
        </label>
      </div>
      <div class="signal-toy__axis-group" role="group" aria-label="Receiver position controls">
        <span class="signal-toy__axis-title">Receiver</span>
        <label>
          <span>X</span>
          <input
            data-toy-range="receiver"
            aria-label="Receiver X"
            aria-describedby="signal-toy-keyboard-help"
            type="range"
            min="48"
            max="432"
            value="370"
          />
        </label>
        <label>
          <span>Y</span>
          <input
            data-toy-range-y="receiver"
            aria-label="Receiver Y"
            aria-describedby="signal-toy-keyboard-help"
            type="range"
            min="54"
            max="166"
            value="82"
          />
        </label>
      </div>
    </div>
    <div class="signal-toy__actions">
      <button data-toy-pulse type="button">
        Send pulse
      </button>
      <button data-toy-reset type="button">
        Reset ↺
      </button>
    </div>
  </div>
  <p class="sr-only" data-toy-pulse-status role="status" aria-atomic="true"></p>
</div>

<script>
  import { updateSignalToy } from '../scripts/signal-toy';

  const toy = document.querySelector<HTMLElement>('[data-signal-toy]');
  if (toy) updateSignalToy(toy);
</script>
