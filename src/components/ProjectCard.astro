---
import type { CollectionEntry } from 'astro:content';
import { roleLabels, statusLabels } from '../data/site';
import ProjectVisual from './ProjectVisual.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  variant?: 'lead' | 'standard' | 'archive';
  showVisual?: boolean;
}

const projectNotes: Record<string, { preview: string; color: string }> = {
  'chronos-dsp': { preview: 'geometry → IQ', color: 'var(--play-blue)' },
  'life-os': { preview: 'SQLite → embeddings → bandit', color: 'var(--play-green)' },
  'modulation-studio': { preview: 'signal → noise → recovery', color: 'var(--play-yellow)' },
  'hpc-boost': { preview: '4 PMU counters → XGBoost', color: 'var(--play-coral)' },
  'moe-memory-wall': { preview: 'experts → HBM cache', color: 'var(--play-lilac)' },
  'riscv-simulator': { preview: 'assembly → registers', color: 'var(--play-blue)' },
  'university-erp': { preview: 'auth + ERP schemas', color: 'var(--play-green)' },
  tasveer: { preview: 'campus media archive', color: 'var(--play-yellow)' },
};

const { project, index, variant = 'standard', showVisual = true } = Astro.props;
const data = project.data;
const shortTitle = data.title.split(':')[0];
const note = projectNotes[project.id] ?? {
  preview: 'project notes',
  color: 'var(--play-yellow)',
};
const datum = `P-${String(index + 1).padStart(2, '0')}`;
const credit = data.creditLabel
  ? data.creditLabel
  : data.teamSize
    ? `${roleLabels[data.role]} · ${data.teamSize} people`
    : roleLabels[data.role];
const primaryLink = data.links.find((link) => link.kind === 'source');
const demoLink = data.links.find((link) => link.kind === 'demo');
---

<article
  id={`project-${project.id}`}
  class={`project-card project-card--${variant}`}
  data-project-card
  data-project={project.id}
  style={`--card-color: ${note.color}`}
>
  <div class="project-card__content">
    <div class="project-card__datum">
      <span class="sr-only">Project </span>
      {datum}
    </div>
    <div class="project-card__meta">
      <span>{statusLabels[data.status]}</span>
      <span>{credit}</span>
    </div>
    <h3>
      <a href={`/work/${project.id}/`}>{shortTitle}</a>
    </h3>
    <p class="project-card__summary">{data.summary}</p>
    <ul class="tag-list" aria-label="Technologies used">
      {data.stack.slice(0, 4).map((item) => (
        <li>{item}</li>
      ))}
    </ul>
    <div class="project-card__actions">
      <a class="arrow-link" href={`/work/${project.id}/`}>
        Read more <span aria-hidden="true">→</span>
      </a>
      {demoLink && (
        <a class="arrow-link" href={demoLink.url} target="_blank" rel="noreferrer noopener">
          Live demo <span aria-hidden="true">↗</span>
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      )}
      {primaryLink && (
        <a class="quiet-link" href={primaryLink.url} target="_blank" rel="noreferrer noopener">
          GitHub <span aria-hidden="true">↗</span>
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      )}
    </div>
  </div>

  {showVisual && data.diagram !== 'none' && (
    <div class="project-card__stage">
      <div class="project-card__stage-bar" aria-hidden="true">
        <span class="project-card__preview-label">DIAGRAM</span>
        <span class="project-card__preview-note">{note.preview}</span>
      </div>
      <ProjectVisual
        id={`card-${project.id}`}
        diagram={data.diagram}
        alt={data.diagramAlt}
        caption={data.diagramCaption}
        preview={true}
        transitionName={`project-${project.id}`}
        projectTitle={shortTitle}
        credit={credit}
      />
    </div>
  )}
</article>
