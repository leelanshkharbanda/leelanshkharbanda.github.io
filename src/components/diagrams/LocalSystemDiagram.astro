---
import '../../styles/diagrams/local-system.css';

interface Props {
  arrowId: string;
  traceArrowId: string;
}

const { arrowId, traceArrowId } = Astro.props;
---

<g class="project-visual__local-system">
  <g data-layout="full">
    <rect
      class="project-visual__boundary ls-core-boundary"
      x="36"
      y="36"
      width="654"
      height="388"
      rx="4"
    />
    <text class="project-visual__eyebrow" x="58" y="66">
      LOCAL DESKTOP CORE
    </text>
    <text class="project-visual__micro" x="668" y="66" text-anchor="end">
      TAURI 2 / ON DEVICE
    </text>

    <rect
      class="project-visual__panel project-visual__panel--raised"
      x="64"
      y="92"
      width="160"
      data-node="react"
      height="76"
      rx="2"
    />
    <text class="project-visual__stage-label" x="84" y="124">
      REACT UI
    </text>
    <text class="project-visual__micro" x="84" y="148">
      views + commands
    </text>

    <rect
      class="project-visual__panel project-visual__panel--raised"
      x="274"
      y="92"
      width="160"
      data-node="tauri"
      height="76"
      rx="2"
    />
    <text class="project-visual__stage-label" x="294" y="124">
      TAURI IPC
    </text>
    <text class="project-visual__micro" x="294" y="148">
      typed boundary
    </text>

    <rect
      class="project-visual__panel project-visual__panel--raised"
      x="484"
      y="92"
      width="174"
      data-node="rust"
      height="76"
      rx="2"
    />
    <text class="project-visual__stage-label" x="504" y="124">
      RUST COMMANDS
    </text>
    <text class="project-visual__micro" x="504" y="148">
      orchestration
    </text>

    <path
      class="project-visual__connector ls-command-flow"
      d="M 224 130 L 272 130"
      marker-end={`url(#${arrowId})`}
      data-connector="react-tauri"
      data-from="react"
      data-to="tauri"
    />
    <path
      class="project-visual__connector ls-command-flow"
      d="M 434 130 L 482 130"
      marker-end={`url(#${arrowId})`}
      data-connector="tauri-rust"
      data-from="tauri"
      data-to="rust"
    />

    <rect
      class="project-visual__panel"
      x="64"
      y="226"
      width="160"
      height="82"
      rx="2"
      data-node="sqlite"
    />
    <text class="project-visual__stage-label" x="84" y="258">
      SQLITE
    </text>
    <text class="project-visual__micro" x="84" y="282">
      local records
    </text>

    <rect
      class="project-visual__panel"
      x="274"
      y="226"
      width="160"
      height="82"
      rx="2"
      data-node="onnx"
    />
    <text class="project-visual__stage-label" x="294" y="258">
      ONNX
    </text>
    <text class="project-visual__micro" x="294" y="282">
      local embeddings
    </text>

    <rect
      class="project-visual__panel"
      x="484"
      y="226"
      width="174"
      height="82"
      rx="2"
      data-node="lancedb"
    />
    <text class="project-visual__stage-label" x="504" y="258">
      LANCEDB
    </text>
    <text class="project-visual__micro" x="504" y="282">
      semantic memory
    </text>

    <path
      class="project-visual__path ls-local-flow"
      d="M 571 168 V 196 H 144"
      data-node="local-bus"
    />
    <path
      class="project-visual__path ls-local-flow"
      d="M 144 196 V 224"
      marker-end={`url(#${traceArrowId})`}
      data-connector="local-sqlite"
      data-from="local-bus"
      data-to="sqlite"
    />
    <path
      class="project-visual__path ls-local-flow"
      d="M 354 196 V 224"
      marker-end={`url(#${traceArrowId})`}
      data-connector="local-onnx"
      data-from="local-bus"
      data-to="onnx"
    />
    <path
      class="project-visual__path ls-local-flow"
      d="M 571 196 V 224"
      marker-end={`url(#${traceArrowId})`}
      data-connector="local-lancedb"
      data-from="local-bus"
      data-to="lancedb"
    />

    <rect
      class="project-visual__panel project-visual__panel--accent"
      x="246"
      y="352"
      width="230"
      data-node="context"
      height="58"
      rx="2"
    />
    <text class="project-visual__stage-label" x="266" y="378">
      CONTEXT + BANDIT
    </text>
    <text class="project-visual__micro" x="266" y="398">
      recommendation + explanation
    </text>

    <path
      class="project-visual__path ls-local-flow"
      d="M 144 308 V 332 H 571 M 354 308 V 332 M 571 308 V 332"
      data-node="context-bus"
    />
    <path
      class="project-visual__path ls-local-flow"
      d="M 354 332 V 350"
      marker-end={`url(#${traceArrowId})`}
      data-connector="context-loop"
      data-from="context-bus"
      data-to="context"
    />

    <rect
      class="project-visual__boundary project-visual__boundary--optional ls-optional-boundary"
      x="734"
      y="92"
      width="190"
      data-node="optional-network"
      height="318"
      rx="4"
    />
    <text class="project-visual__eyebrow" x="754" y="122">
      SETUP / NETWORK
    </text>
    <text class="project-visual__micro" x="754" y="145">
      outside local core
    </text>
    <path class="ls-divider" d="M 754 160 H 900" />

    <text class="project-visual__micro" x="754" y="184">
      REQUIRED SETUP
    </text>
    <rect
      class="project-visual__panel ls-setup-node"
      x="754"
      y="196"
      width="150"
      height="50"
      rx="2"
    />
    <text class="project-visual__stage-label" x="766" y="218">
      MODEL SETUP
    </text>
    <text class="project-visual__micro" x="766" y="236">
      required file
    </text>

    <text class="project-visual__eyebrow" x="754" y="278">
      OPTIONAL NETWORK
    </text>
    <rect
      class="project-visual__panel ls-optional-node"
      x="754"
      y="290"
      width="150"
      height="50"
      rx="2"
    />
    <text class="project-visual__body" x="766" y="311">
      Google Calendar
    </text>
    <text class="project-visual__micro" x="766" y="330">
      sync (optional)
    </text>
    <rect
      class="project-visual__panel ls-optional-node"
      x="754"
      y="346"
      width="150"
      height="50"
      rx="2"
    />
    <text class="project-visual__body" x="766" y="367">
      exercise lookup
    </text>
    <text class="project-visual__micro" x="766" y="384">
      optional
    </text>

    <path
      class="project-visual__connector project-visual__connector--dashed ls-optional-flow"
      d="M 658 150 H 712 V 312 H 752"
      marker-end={`url(#${arrowId})`}
      data-connector="optional-network"
      data-from="rust"
      data-to="optional-network"
    />
  </g>

  <g data-layout="compact">
    <rect
      class="project-visual__boundary ls-compact-core-boundary"
      x="40"
      y="48"
      data-node="local-core"
      width="584"
      height="364"
      rx="4"
    />
    <text class="ls-compact-boundary-label" x="64" y="96">
      LOCAL CORE
    </text>

    <rect
      class="project-visual__panel project-visual__panel--raised ls-compact-node"
      x="64"
      y="124"
      width="160"
      data-node="ui"
      height="68"
      rx="2"
    />
    <text class="ls-compact-title" x="144" y="174" text-anchor="middle">
      UI
    </text>

    <rect
      class="project-visual__panel project-visual__panel--raised ls-compact-node"
      x="256"
      y="124"
      width="160"
      data-node="ipc"
      height="68"
      rx="2"
    />
    <text class="ls-compact-title" x="336" y="174" text-anchor="middle">
      IPC
    </text>

    <rect
      class="project-visual__panel project-visual__panel--raised ls-compact-node"
      x="448"
      y="124"
      width="160"
      data-node="rust-compact"
      height="68"
      rx="2"
    />
    <text class="ls-compact-title" x="528" y="174" text-anchor="middle">
      RUST
    </text>

    <path
      class="project-visual__connector ls-compact-connector"
      d="M 224 158 H 254"
      marker-end={`url(#${arrowId})`}
      data-connector="compact-ui-ipc"
      data-from="ui"
      data-to="ipc"
    />
    <path
      class="project-visual__connector ls-compact-connector"
      d="M 416 158 H 446"
      marker-end={`url(#${arrowId})`}
      data-connector="compact-ipc-rust"
      data-from="ipc"
      data-to="rust-compact"
    />

    <rect
      class="project-visual__panel ls-compact-node"
      x="64"
      y="236"
      width="184"
      data-node="sqlite-compact"
      height="68"
      rx="2"
    />
    <text class="ls-compact-data-title" x="156" y="286" text-anchor="middle">
      SQLITE
    </text>

    <rect
      class="project-visual__panel ls-compact-node"
      x="280"
      y="236"
      width="128"
      data-node="onnx-compact"
      height="68"
      rx="2"
    />
    <text class="ls-compact-data-title" x="344" y="286" text-anchor="middle">
      ONNX
    </text>

    <rect
      class="project-visual__panel ls-compact-node"
      x="440"
      y="236"
      width="168"
      data-node="lance-compact"
      height="68"
      rx="2"
    />
    <text class="ls-compact-data-title" x="524" y="286" text-anchor="middle">
      LANCE
    </text>

    <path
      class="project-visual__path ls-compact-path"
      d="M 528 192 V 214 H 156"
      data-node="local-bus-compact"
    />
    <path
      class="project-visual__path ls-compact-path"
      d="M 156 214 V 234"
      marker-end={`url(#${traceArrowId})`}
      data-connector="compact-local-sqlite"
      data-from="local-bus-compact"
      data-to="sqlite-compact"
    />
    <path
      class="project-visual__path ls-compact-path"
      d="M 344 214 V 234"
      marker-end={`url(#${traceArrowId})`}
      data-connector="compact-local-onnx"
      data-from="local-bus-compact"
      data-to="onnx-compact"
    />
    <path
      class="project-visual__path ls-compact-path"
      d="M 524 214 V 234"
      marker-end={`url(#${traceArrowId})`}
      data-connector="compact-local-lance"
      data-from="local-bus-compact"
      data-to="lance-compact"
    />

    <rect
      class="project-visual__panel project-visual__panel--accent ls-compact-context"
      x="88"
      y="342"
      width="496"
      data-node="context-compact"
      height="56"
      rx="2"
    />
    <text class="ls-compact-data-title" x="336" y="377" text-anchor="middle">
      CONTEXT + BANDIT
    </text>

    <path
      class="project-visual__path ls-compact-path"
      d="M 156 304 V 322 H 524 M 344 304 V 322 M 524 304 V 322"
      data-node="context-bus-compact"
    />
    <path
      class="project-visual__path ls-compact-path"
      d="M 340 322 V 340"
      marker-end={`url(#${traceArrowId})`}
      data-connector="compact-context-loop"
      data-from="context-bus-compact"
      data-to="context-compact"
    />

    <rect
      class="project-visual__boundary project-visual__boundary--optional ls-compact-optional-boundary"
      x="656"
      y="48"
      width="264"
      data-node="optional-compact"
      height="364"
      rx="4"
    />
    <text class="ls-compact-optional-title" x="680" y="96">
      SETUP
    </text>

    <rect class="ls-compact-setup-node" x="668" y="116" width="240" height="68" rx="2" />
    <text class="ls-compact-setup-title" x="788" y="166" text-anchor="middle">
      REQUIRED
    </text>

    <text class="ls-compact-optional-title" x="680" y="238">
      OPTIONAL
    </text>
    <rect class="ls-compact-optional-node" x="668" y="258" width="240" height="126" rx="2" />
    <text class="ls-compact-optional-detail" x="788" y="306" text-anchor="middle">
      CALENDAR
    </text>
    <text class="ls-compact-optional-detail" x="788" y="366" text-anchor="middle">
      EXERCISE
    </text>

    <path
      class="project-visual__connector project-visual__connector--dashed ls-compact-optional-flow"
      d="M 624 158 H 640 V 321 H 666"
      marker-end={`url(#${arrowId})`}
      data-connector="compact-optional"
      data-from="local-core"
      data-to="optional-compact"
    />
  </g>
</g>
