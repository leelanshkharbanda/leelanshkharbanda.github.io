          <text class="project-visual__eyebrow" x="54" y="196">
            OFF-CHIP EXPERTS
          </text>
          <g class="project-visual__expert-grid">
            {Array.from({ length: 16 }, (_, index) => (
              <rect
                class={`project-visual__expert-cell ${index % 5 === 0 ? 'project-visual__expert-cell--predicted' : ''}`}
