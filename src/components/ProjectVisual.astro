---
import CounterLedgerDiagram from './diagrams/CounterLedgerDiagram.astro';
import ConstellationDiagram from './diagrams/ConstellationDiagram.astro';
import InstructionTraceDiagram from './diagrams/InstructionTraceDiagram.astro';
import LocalSystemDiagram from './diagrams/LocalSystemDiagram.astro';
import MemoryGridDiagram from './diagrams/MemoryGridDiagram.astro';
import SignalPathDiagram from './diagrams/SignalPathDiagram.astro';

export type ProjectDiagram =
  | 'signal-path'
  | 'local-system'
  | 'constellation'
  | 'counter-ledger'
  | 'memory-grid'
  | 'instruction-trace'
  | 'none';

interface Props {
  id: string;
  diagram: ProjectDiagram;
  alt: string;
  caption: string;
  preview?: boolean;
  transitionName?: string;
  projectTitle?: string;
  credit?: string;
}

const {
  id,
  diagram,
  alt,
  caption,
  preview = false,
  transitionName,
  projectTitle,
  credit,
} = Astro.props;
const safeId =
  id
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9_-]+/g, '-')
    .replace(/^-+|-+$/g, '') || 'project';
const figureId = `project-visual-${safeId}`;
const titleId = `${figureId}-title`;
const descriptionId = `${figureId}-description`;
const arrowId = `${figureId}-arrow`;
const traceArrowId = `${figureId}-trace-arrow`;

const descriptions: Record<ProjectDiagram, string> = {
  'signal-path':
    'Original four-stage schematic connecting scene geometry and a seeded QPSK source to a multipath channel, receiver decisions, and simulated IQ and BER outputs. All values are illustrative, not hardware measurements.',
  'local-system':
    'Original desktop-boundary schematic connecting React, Tauri IPC, Rust commands, SQLite, ONNX inference, LanceDB memory, and contextual recommendations. Required model provisioning and optional network integrations remain outside the local core.',
  constellation:
    'Original three-panel QPSK schematic comparing ideal source symbols, an illustrative impaired channel view, and recovered decisions from a fixed seed. The points are simulated, not measured.',
  'counter-ledger':
    'Original experiment ledger connecting grouped PMU traces, a four-event candidate budget, training-only subset selection, held-out binary evaluation, and the negative per-binary conditioning decision.',
  'memory-grid':
    'Original memory-system schematic connecting off-chip experts, a predictor, one copy link, a bounded HBM cache, demand priority, and exposed decode stalls. It describes a simulation boundary, not measured GPU performance.',
  'instruction-trace':
    'Original functional execution trace connecting RV32I-subset assembly, instruction fields, program-counter updates, register state, and memory output. It does not represent cycle timing or complete ISA conformance.',
  none: 'No visual is rendered.',
};

const viewBoxes: Record<Exclude<ProjectDiagram, 'none'>, string> = {
  'signal-path': '0 0 960 430',
  'local-system': '0 0 960 460',
  constellation: '0 0 960 370',
  'counter-ledger': '0 0 960 400',
  'memory-grid': '0 0 960 430',
  'instruction-trace': '0 0 960 430',
};
---

{diagram !== 'none' && (
  <figure
    class={`project-visual__root${preview ? ' project-visual__root--preview' : ''}`}
    id={figureId}
    data-diagram={diagram}
    data-project-title={projectTitle}
    data-project-credit={credit}
    aria-label={alt}
    style={transitionName ? `--visual-transition-name: ${transitionName};` : undefined}
  >
    <svg
      class={`project-visual__svg project-visual__svg--${diagram}`}
      viewBox={viewBoxes[diagram]}
      width="960"
      height={
        diagram === 'local-system'
          ? 460
          : diagram === 'constellation'
            ? 370
            : diagram === 'counter-ledger'
              ? 400
              : 430
      }
      role="img"
      aria-labelledby={titleId}
      aria-describedby={descriptionId}
      focusable="false"
      preserveAspectRatio="xMidYMid meet"
    >
      <title id={titleId}>{alt}</title>
      <desc id={descriptionId}>{descriptions[diagram]}</desc>
      <defs>
        <marker
          id={arrowId}
          class="project-visual__arrow"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path class="project-visual__arrow-path" d="M 0 0 L 10 5 L 0 10 z" />
        </marker>
        <marker
          id={traceArrowId}
          class="project-visual__arrow project-visual__arrow--trace"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path class="project-visual__arrow-path" d="M 0 0 L 10 5 L 0 10 z" />
        </marker>
      </defs>

      {diagram === 'signal-path' && (
        <SignalPathDiagram arrowId={arrowId} traceArrowId={traceArrowId} />
      )}
      {diagram === 'local-system' && (
        <LocalSystemDiagram arrowId={arrowId} traceArrowId={traceArrowId} />
      )}
      {diagram === 'constellation' && <ConstellationDiagram arrowId={arrowId} />}
      {diagram === 'counter-ledger' && <CounterLedgerDiagram arrowId={arrowId} />}
      {diagram === 'memory-grid' && <MemoryGridDiagram traceArrowId={traceArrowId} />}
      {diagram === 'instruction-trace' && <InstructionTraceDiagram arrowId={arrowId} />}
    </svg>

    <noscript>
      <p class="project-visual__transcript">{descriptions[diagram]}</p>
    </noscript>

    <figcaption class="project-visual__caption">
      <span class="project-visual__caption-text">{caption}</span>
      <button
        class="project-visual__inspect"
        type="button"
        data-diagram-inspect
        aria-controls="diagram-inspector"
        aria-haspopup="dialog"
        aria-label={projectTitle ? `Inspect ${projectTitle} diagram` : 'Inspect diagram'}
        hidden
      >
        Inspect <span aria-hidden="true">↗</span>
      </button>
    </figcaption>
  </figure>
)}
