---
import {
  generateConstellationPoints,
  projectConstellationPoint,
  type ConstellationPoint,
  type SignalStageId,
} from '../lib/signal-model';

export type ProjectDiagram =
  | 'signal-path'
  | 'local-system'
  | 'constellation'
  | 'counter-ledger'
  | 'memory-grid'
  | 'instruction-trace'
  | 'none';

interface Props {
  id: string;
  diagram: ProjectDiagram;
  alt: string;
  caption: string;
  preview?: boolean;
  transitionName?: string;
  projectTitle?: string;
  credit?: string;
}

const {
  id,
  diagram,
  alt,
  caption,
  preview = false,
  transitionName,
  projectTitle,
  credit,
} = Astro.props;
const safeId =
  id
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9_-]+/g, '-')
    .replace(/^-+|-+$/g, '') || 'project';
const figureId = `project-visual-${safeId}`;
const titleId = `${figureId}-title`;
const descriptionId = `${figureId}-description`;
const scrollDescriptionId = `${figureId}-scroll-description`;
const arrowId = `${figureId}-arrow`;
const traceArrowId = `${figureId}-trace-arrow`;

const descriptions: Record<ProjectDiagram, string> = {
  'signal-path':
    'Original four-stage schematic connecting scene geometry and a seeded QPSK source to a multipath channel, receiver decisions, and simulated IQ and BER outputs. All values are illustrative, not hardware measurements.',
  'local-system':
    'Original desktop-boundary schematic connecting React, Tauri IPC, Rust commands, SQLite, ONNX inference, LanceDB memory, and contextual recommendations. Required model provisioning and optional network integrations remain outside the local core.',
  constellation:
    'Original three-panel QPSK schematic comparing ideal source symbols, an illustrative impaired channel view, and recovered decisions from a fixed seed. The points are simulated, not measured.',
  'counter-ledger':
    'Original experiment ledger connecting grouped PMU traces, a four-event candidate budget, training-only subset selection, held-out binary evaluation, and the negative per-binary conditioning decision.',
  'memory-grid':
    'Original memory-system schematic connecting off-chip experts, a predictor, one copy link, a bounded HBM cache, demand priority, and exposed decode stalls. It describes a simulation boundary, not measured GPU performance.',
  'instruction-trace':
    'Original functional execution trace connecting RV32I-subset assembly, instruction fields, program-counter updates, register state, and memory output. It does not represent cycle timing or complete ISA conformance.',
  none: 'No visual is rendered.',
};

const viewBoxes: Record<Exclude<ProjectDiagram, 'none'>, string> = {
  'signal-path': '0 0 960 430',
  'local-system': '0 0 960 460',
  constellation: '0 0 960 370',
  'counter-ledger': '0 0 960 400',
  'memory-grid': '0 0 960 430',
  'instruction-trace': '0 0 960 430',
};

const constellationPlots: {
  id: SignalStageId;
  label: string;
  x: number;
  points: readonly ConstellationPoint[];
}[] = [
  {
    id: 'source',
    label: 'SOURCE / QPSK',
    x: 40,
    points: generateConstellationPoints('source', { count: 32 }),
  },
  {
    id: 'channel',
    label: 'CHANNEL / IMPAIRED',
    x: 360,
    points: generateConstellationPoints('channel', { count: 32 }),
  },
  {
    id: 'receiver',
    label: 'RECEIVER / DECISIONS',
    x: 680,
    points: generateConstellationPoints('receiver', { count: 32 }),
  },
];
---

{diagram !== 'none' && (
  <figure
    class={`project-visual__root${preview ? ' project-visual__root--preview' : ''}`}
    id={figureId}
    data-diagram={diagram}
    data-project-title={projectTitle}
    data-project-credit={credit}
    data-visual-scroll
    tabindex="0"
    aria-label={alt}
    aria-describedby={scrollDescriptionId}
    style={transitionName ? `--visual-transition-name: ${transitionName};` : undefined}
  >
    <span class="sr-only" id={scrollDescriptionId}>
      If the schematic is wider than its frame, use Left and Right Arrow keys or scroll
      horizontally.
    </span>
    <svg
      class={`project-visual__svg project-visual__svg--${diagram}`}
      viewBox={viewBoxes[diagram]}
      width="960"
      height={
        diagram === 'local-system'
          ? 460
          : diagram === 'constellation'
            ? 370
            : diagram === 'counter-ledger'
              ? 400
              : 430
      }
      role="img"
      aria-labelledby={`${titleId} ${descriptionId}`}
      focusable="false"
      preserveAspectRatio="xMidYMid meet"
    >
      <title id={titleId}>{alt}</title>
      <desc id={descriptionId}>{descriptions[diagram]}</desc>
      <defs>
        <marker
          id={arrowId}
          class="project-visual__arrow"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path class="project-visual__arrow-path" d="M 0 0 L 10 5 L 0 10 z" />
        </marker>
        <marker
          id={traceArrowId}
          class="project-visual__arrow project-visual__arrow--trace"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path class="project-visual__arrow-path" d="M 0 0 L 10 5 L 0 10 z" />
        </marker>
      </defs>

      {diagram === 'signal-path' && (
        <g class="project-visual__signal-path">
          <rect class="project-visual__panel" x="24" y="24" width="912" height="156" rx="2" />
          <text class="project-visual__eyebrow" x="44" y="52">
            01 / SCENE GEOMETRY
          </text>
          <text class="project-visual__micro" x="916" y="52" text-anchor="end">
            ILLUSTRATIVE / SEEDED
          </text>

          <circle class="project-visual__node-fill" cx="92" cy="126" r="15" />
          <text class="project-visual__node-label" x="92" y="131" text-anchor="middle">
            TX
          </text>
          <text class="project-visual__micro" x="92" y="96" text-anchor="middle">
            SOURCE
          </text>

          <path class="project-visual__wall" d="M 196 76 L 196 166 M 352 84 L 352 158" />
          <text class="project-visual__micro" x="208" y="92">
            WALL A
          </text>
          <text class="project-visual__micro" x="364" y="100">
            WALL B
          </text>

          <path
            class="project-visual__path"
            d="M 107 120 L 294 120"
            marker-end={`url(#${traceArrowId})`}
          />
          <path
            class="project-visual__path project-visual__path--dashed"
            d="M 107 126 L 196 78 L 352 88 L 294 126"
            marker-end={`url(#${traceArrowId})`}
          />
          <path
            class="project-visual__path project-visual__path--dotted"
            d="M 107 132 L 246 164 L 352 150 L 294 132"
            marker-end={`url(#${traceArrowId})`}
          />

          <circle class="project-visual__node-fill" cx="310" cy="126" r="15" />
          <text class="project-visual__node-label" x="310" y="131" text-anchor="middle">
            RX
          </text>
          <text class="project-visual__micro" x="310" y="96" text-anchor="middle">
            RECEIVER
          </text>

          <path class="project-visual__rule" d="M 430 76 L 430 164" />
          <path
            class="project-visual__connector"
            d="M 430 102 L 518 102"
            marker-end={`url(#${arrowId})`}
          />
          <rect
            class="project-visual__panel project-visual__panel--raised"
            x="520"
            y="70"
            width="386"
            height="70"
            rx="2"
          />
          <text class="project-visual__eyebrow" x="540" y="96">
            CANDIDATE PATHS
          </text>
          <text class="project-visual__body" x="540" y="120">
            line of sight · reflection · transmission
          </text>
          <text class="project-visual__micro" x="886" y="96" text-anchor="end">
            BOUNDED SCENE
          </text>

          <path
            class="project-visual__connector"
            d="M 126 180 L 126 268"
            marker-end={`url(#${arrowId})`}
          />
          <path
            class="project-visual__connector"
            d="M 346 180 L 346 268"
            marker-end={`url(#${arrowId})`}
          />
          <path
            class="project-visual__connector"
            d="M 566 180 L 566 268"
            marker-end={`url(#${arrowId})`}
          />
          <path
            class="project-visual__connector"
            d="M 786 180 L 786 268"
            marker-end={`url(#${arrowId})`}
          />

          {[
            { x: 40, datum: 'TS-01', label: 'SOURCE', detail: 'QPSK + seed' },
            { x: 260, datum: 'TS-02', label: 'CHANNEL', detail: 'paths + impairment' },
            { x: 480, datum: 'TS-03', label: 'RECEIVER', detail: 'decisions + phase' },
            { x: 700, datum: 'TS-04', label: 'OUTPUT', detail: 'IQ + BER' },
          ].map((stage) => (
            <g class="project-visual__stage" data-stage={stage.datum}>
              <rect
                class="project-visual__stage-box"
                x={stage.x}
                y="270"
                width="172"
                height="104"
                rx="2"
              />
              <text class="project-visual__datum" x={stage.x + 16} y="294">
                {stage.datum}
              </text>
              <text class="project-visual__stage-label" x={stage.x + 16} y="326">
                {stage.label}
              </text>
              <text class="project-visual__micro" x={stage.x + 16} y="352">
                {stage.detail}
              </text>
            </g>
          ))}

          <path
            class="project-visual__connector"
            d="M 212 322 L 258 322"
            marker-end={`url(#${arrowId})`}
          />
          <path
            class="project-visual__connector"
            d="M 432 322 L 478 322"
            marker-end={`url(#${arrowId})`}
          />
          <path
            class="project-visual__connector"
            d="M 652 322 L 698 322"
            marker-end={`url(#${arrowId})`}
          />

          <polyline
            class="project-visual__wave"
            points="720,402 736,402 744,388 752,416 760,374 768,426 776,390 784,414 792,402 812,402 828,402 836,390 844,414 852,378 860,422 868,394 876,410 884,402 904,402"
          />
          <text class="project-visual__micro" x="40" y="408">
            BASEBAND SIMULATION
          </text>
        </g>
      )}

      {diagram === 'local-system' && (
        <g class="project-visual__local-system">
          <rect class="project-visual__boundary" x="36" y="36" width="654" height="388" rx="4" />
          <text class="project-visual__eyebrow" x="58" y="66">
            LOCAL DESKTOP CORE
          </text>
          <text class="project-visual__micro" x="668" y="66" text-anchor="end">
