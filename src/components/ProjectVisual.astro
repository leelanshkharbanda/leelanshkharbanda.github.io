            SQLITE
          </text>
          <text class="project-visual__micro" x="84" y="282">
            local records
          </text>

          <rect class="project-visual__panel" x="274" y="226" width="160" height="82" rx="2" />
          <text class="project-visual__stage-label" x="294" y="258">
            ONNX
          </text>
          <text class="project-visual__micro" x="294" y="282">
            local embeddings
          </text>

          <rect class="project-visual__panel" x="484" y="226" width="174" height="82" rx="2" />
          <text class="project-visual__stage-label" x="504" y="258">
            LANCEDB
          </text>
          <text class="project-visual__micro" x="504" y="282">
            semantic memory
          </text>

          <path
            class="project-visual__path"
            d="M 526 168 L 526 196 L 144 196 L 144 224"
            marker-end={`url(#${traceArrowId})`}
          />
          <path
            class="project-visual__path"
            d="M 548 168 L 548 214 L 354 214 L 354 224"
            marker-end={`url(#${traceArrowId})`}
          />
          <path
            class="project-visual__path"
            d="M 571 168 L 571 224"
            marker-end={`url(#${traceArrowId})`}
          />

          <rect
            class="project-visual__panel project-visual__panel--accent"
            x="246"
            y="352"
            width="230"
            height="58"
            rx="2"
          />
          <text class="project-visual__stage-label" x="266" y="378">
            CONTEXT + BANDIT
          </text>
          <text class="project-visual__micro" x="266" y="398">
            recommendation + explanation
          </text>

          <path
            class="project-visual__path"
            d="M 144 308 L 144 328 L 326 328 L 326 350"
            marker-end={`url(#${traceArrowId})`}
          />
          <path
            class="project-visual__path"
            d="M 354 308 L 354 350"
            marker-end={`url(#${traceArrowId})`}
          />
          <path
            class="project-visual__path"
            d="M 571 308 L 571 340 L 396 340 L 396 350"
            marker-end={`url(#${traceArrowId})`}
          />

          <rect
            class="project-visual__boundary project-visual__boundary--optional"
            x="734"
            y="92"
            width="190"
            height="318"
            rx="4"
          />
          <text class="project-visual__eyebrow" x="754" y="122">
            SETUP / NETWORK
          </text>
          <text class="project-visual__micro" x="754" y="148">
            required model setup
          </text>
          <text class="project-visual__micro" x="754" y="164">
            + optional integrations
          </text>
          <text class="project-visual__body" x="754" y="202">
            model provisioning
          </text>
          <text class="project-visual__body" x="754" y="238">
            exercise lookup
          </text>
          <text class="project-visual__body" x="754" y="256">
            (optional)
          </text>
          <text class="project-visual__body" x="754" y="280">
            calendar sync
          </text>
          <text class="project-visual__body" x="754" y="298">
            (optional)
          </text>
          <text class="project-visual__micro" x="754" y="344">
            OPTIONAL NETWORK
          </text>
          <path
            class="project-visual__connector project-visual__connector--dashed"
            d="M 690 246 L 732 246"
            marker-end={`url(#${arrowId})`}
          />
        </g>
      )}

      {diagram === 'constellation' && (
        <g class="project-visual__constellation">
          {constellationPlots.map((plot) => (
            <g
              class="project-visual__plot"
              data-stage={plot.id}
              transform={`translate(${plot.x} 76)`}
            >
              <text class="project-visual__eyebrow" x="0" y="-20">
                {plot.label}
              </text>
              <rect
                class="project-visual__plot-frame"
                x="0"
                y="0"
                width="240"
                height="240"
                rx="2"
              />
              <path class="project-visual__axis" d="M 120 12 L 120 228 M 12 120 L 228 120" />
              <path class="project-visual__decision" d="M 120 12 L 120 228 M 12 120 L 228 120" />
              <text class="project-visual__micro" x="228" y="112" text-anchor="end">
                I
              </text>
              <text class="project-visual__micro" x="128" y="20">
                Q
              </text>
              {plot.points.map((point) => {
                const projected = projectConstellationPoint(point, 240);
                return (
                  <circle
                    class={`project-visual__point project-visual__point--${plot.id}`}
                    cx={projected.x}
                    cy={projected.y}
                    r="4.5"
                  />
                );
              })}
              <text class="project-visual__micro" x="0" y="264">
                FIXED SEED / 32 POINTS
              </text>
            </g>
          ))}
          <path
            class="project-visual__connector"
            d="M 280 196 L 358 196"
            marker-end={`url(#${arrowId})`}
          />
          <path
            class="project-visual__connector"
            d="M 600 196 L 678 196"
            marker-end={`url(#${arrowId})`}
          />
          <text class="project-visual__micro" x="40" y="352">
            QPSK CONSTELLATION PIPELINE
          </text>
        </g>
      )}

      {diagram === 'counter-ledger' && (
        <g class="project-visual__counter-ledger">
          <text class="project-visual__eyebrow" x="40" y="44">
            V2 / FIXED-SUBSET EXPERIMENT LEDGER
          </text>
          <text class="project-visual__micro" x="920" y="44" text-anchor="end">
            GROUP BY BINARY
          </text>

          {[
            { x: 40, datum: '01', label: 'PMU TRACES', detail: 'repeated runs' },
            { x: 224, datum: '02', label: 'EVENT GROUPS', detail: '≤ 4 at once' },
            { x: 408, datum: '03', label: 'SUBSETS', detail: 'training only' },
            { x: 592, datum: '04', label: 'FIXED SET', detail: 'one selector' },
            { x: 776, datum: '05', label: 'HELD OUT', detail: 'whole binaries' },
          ].map((row) => (
            <g class="project-visual__ledger-row">
              <rect
                class="project-visual__stage-box"
                x={row.x}
                y="76"
                width="144"
                height="102"
                rx="2"
              />
              <text class="project-visual__datum" x={row.x + 14} y="102">
                {row.datum}
              </text>
              <text class="project-visual__stage-label" x={row.x + 14} y="134">
                {row.label}
              </text>
              <text class="project-visual__micro" x={row.x + 14} y="158">
