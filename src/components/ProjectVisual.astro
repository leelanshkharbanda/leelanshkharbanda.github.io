          <rect
            class="project-visual__panel project-visual__panel--raised"
            x="54"
            y="70"
            width="250"
            height="66"
            rx="2"
          />
          <text class="project-visual__stage-label" x="74" y="98">
            NEXT-LAYER PREDICTOR
          </text>
          <text class="project-visual__micro" x="74" y="120">
            causal · training-free · bounded
          </text>
          <path
            class="project-visual__path project-visual__connector--dashed"
            d="M 179 136 L 179 164 L 500 164 L 500 196"
