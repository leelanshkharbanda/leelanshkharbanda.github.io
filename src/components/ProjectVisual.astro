          ))}

          <path
            class="project-visual__connector"
            d="M 184 127 L 222 127"
            marker-end={`url(#${arrowId})`}
          />
          <path
            class="project-visual__connector"
            d="M 368 127 L 406 127"
            marker-end={`url(#${arrowId})`}
          />
          <path
            class="project-visual__connector"
            d="M 552 127 L 590 127"
            marker-end={`url(#${arrowId})`}
          />
          <path
            class="project-visual__connector"
            d="M 736 127 L 774 127"
            marker-end={`url(#${arrowId})`}
          />

          <rect class="project-visual__panel" x="40" y="222" width="440" height="126" rx="2" />
          <text class="project-visual__eyebrow" x="60" y="252">
            SELECTION BOUNDARY
          </text>
          <text class="project-visual__body" x="60" y="282">
            candidate events → inner validation → threshold
          </text>
          <text class="project-visual__body" x="60" y="312">
            held-out binaries never choose the subset
          </text>
          <text class="project-visual__micro" x="60" y="334">
            NO RUN-LEVEL LEAKAGE
          </text>

          <path
            class="project-visual__connector"
            d="M 664 178 L 664 204 L 250 204 L 250 220"
