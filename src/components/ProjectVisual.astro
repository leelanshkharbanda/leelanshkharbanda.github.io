            orchestration
          </text>

          <path
            class="project-visual__connector"
            d="M 224 130 L 272 130"
            marker-end={`url(#${arrowId})`}
          />
          <path
            class="project-visual__connector"
            d="M 434 130 L 482 130"
            marker-end={`url(#${arrowId})`}
          />

          <rect class="project-visual__panel" x="64" y="226" width="160" height="82" rx="2" />
