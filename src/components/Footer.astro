---
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="page-shell site-footer__inner">
    <div class="site-footer__top">
      <div>
        <p class="eyebrow">2026</p>
        <p class="site-footer__statement">{site.name} · IIIT Delhi</p>
      </div>
      <a href={`mailto:${site.email}?subject=Portfolio`}>{site.email}</a>
    </div>
    <div class="site-footer__bottom">
      <p>© 2026 {site.name}</p>
      <div class="site-footer__links">
        <a href={site.github} target="_blank" rel="noreferrer noopener">
          GitHub ↗
        </a>
        <a href={site.linkedin} target="_blank" rel="noreferrer noopener">
          LinkedIn ↗
        </a>
        <a href="/resume/">Résumé</a>
      </div>
      <button class="text-button motion-toggle" type="button" hidden>
        Reduce motion
      </button>
    </div>
  </div>
</footer>

<script>
  const motionToggle = document.querySelector<HTMLButtonElement>('.motion-toggle');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const syncMotionControl = () => {
    if (!motionToggle) return;
    const manualReduced = document.documentElement.dataset.motion === 'reduced';
    motionToggle.hidden = reducedMotion.matches;
    motionToggle.textContent = manualReduced ? 'Enable motion' : 'Reduce motion';
  };

  if (motionToggle) {
    motionToggle.addEventListener('click', () => {
      const manualReduced = document.documentElement.dataset.motion === 'reduced';
      if (manualReduced) delete document.documentElement.dataset.motion;
      else document.documentElement.dataset.motion = 'reduced';
      try {
        if (manualReduced) localStorage.removeItem('portfolio-motion');
        else localStorage.setItem('portfolio-motion', 'reduced');
      } catch {
        // Session-only preference is sufficient when storage is unavailable.
      }
      syncMotionControl();
    });
  }

  try {
    if (localStorage.getItem('portfolio-motion') === 'reduced') {
      document.documentElement.dataset.motion = 'reduced';
    }
  } catch {
    // The OS preference and in-memory control still work without storage.
  }

  reducedMotion.addEventListener('change', syncMotionControl);
  syncMotionControl();
</script>
