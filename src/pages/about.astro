---
import { getEntry } from 'astro:content';
import ContactBlock from '../components/ContactBlock.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homepageProjects } from '../data/curation';
import { requireProjectEntries } from '../data/projects';
import { roleLabels, site, statusLabels } from '../data/site';
import { toolkit } from '../data/toolkit';

const entries = await Promise.all(homepageProjects.map((slug) => getEntry('projects', slug)));
const threads = requireProjectEntries(homepageProjects, entries);
const threadNotes: Record<string, string> = {
  'chronos-dsp': 'Elixir + Rust channel sim',
  'life-os': 'Tauri + SQLite + ONNX',
  'modulation-studio': 'Browser DSP & constellations',
};
const description = 'About Leelansh Kharbanda, B.Tech ECE undergrad at IIIT Delhi.';
---

<BaseLayout title="About" description={description}>
  <section class="about-hero page-shell" aria-labelledby="page-title">
    <div>
      <p class="play-kicker">{site.education}</p>
      <h1 id="page-title">About me.</h1>
      <p class="about-hero__intro">
        ECE undergrad at IIIT Delhi. I spend most of my time building software around signal
        processing, computer architecture, and systems.
      </p>
    </div>
    <div class="curiosity-map" aria-hidden="true">
      <svg viewBox="0 0 520 360" role="none">
        <defs>
          <pattern id="about-map-dots" width="22" height="22" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="1.4" fill="#1d1e19" opacity="0.2" />
          </pattern>
        </defs>
        <rect width="520" height="360" fill="url(#about-map-dots)" />
        <path
          d="M 85 114 C 162 38, 218 182, 285 100 S 401 66, 449 172"
          fill="none"
          stroke="#1d1e19"
          stroke-width="3"
          stroke-dasharray="8 7"
        />
        <path
          d="M 105 145 C 165 248, 267 253, 332 250 S 406 224, 449 172"
          fill="none"
          stroke="#1d1e19"
          stroke-width="2"
        />
        <path
          d="M 268 140 C 232 184, 184 205, 118 134"
          fill="none"
          stroke="#c84627"
          stroke-width="3"
        />
        <circle cx="85" cy="114" r="38" fill="#dfff68" stroke="#1d1e19" stroke-width="3" />
        <circle cx="285" cy="100" r="45" fill="#ffdc63" stroke="#1d1e19" stroke-width="3" />
        <circle cx="449" cy="172" r="34" fill="#ff8567" stroke="#1d1e19" stroke-width="3" />
        <circle cx="182" cy="212" r="13" fill="#6072f5" stroke="#1d1e19" stroke-width="3" />
        <circle cx="332" cy="250" r="24" fill="#f6f2e7" stroke="#1d1e19" stroke-width="3" />
        <path
          d="M 70 83 l 10 -18 M 98 68 l 7 -20 M 458 220 l 18 8"
          stroke="#1d1e19"
          stroke-width="3"
          stroke-linecap="round"
        />
        <text x="85" y="120" text-anchor="middle" class="curiosity-map__text">
          BUILD
        </text>
        <text x="285" y="106" text-anchor="middle" class="curiosity-map__text">
          TEST
        </text>
        <text x="449" y="178" text-anchor="middle" class="curiosity-map__text">
          SHIP
        </text>
      </svg>
    </div>
  </section>

  <section class="about-story page-shell" aria-labelledby="story-title">
    <SectionHeading id="01" headingId="story-title" title="Background" />
    <div class="about-story__grid">
      <div class="prose">
        <p>
          I’m studying Electronics and Communication Engineering at IIIT Delhi (2024–present). Most
          of my projects sit somewhere between hardware concepts and software—wireless channel
          simulators, CPU performance counter experiments, memory hierarchy models, and desktop
          apps.
        </p>
        <p>Right now I’m writing a lot of Rust, Python, TypeScript, and Elixir.</p>
      </div>
      <aside class="about-principles" aria-label="Current interests">
        <p class="datum-label">INTO RIGHT NOW</p>
        <ol>
          <li>Wireless &amp; DSP simulations</li>
          <li>Computer architecture &amp; PMUs</li>
          <li>Rust, Elixir &amp; local desktop apps</li>
          <li>Campus media &amp; events at Tasveer</li>
        </ol>
      </aside>
    </div>
  </section>

  <section class="about-threads page-shell" aria-labelledby="threads-title">
    <SectionHeading id="02" headingId="threads-title" title="Featured projects" />
    <div class="about-thread-grid">
      {threads.map((project) => {
        const data = project.data;
        const shortTitle = data.title.split(':')[0];
        const credit = data.creditLabel
          ? data.creditLabel
          : data.teamSize
            ? `${roleLabels[data.role]} · ${data.teamSize} people`
            : roleLabels[data.role];
        return (
          <a class="about-thread" href={`/work/${project.id}/`}>
            <span class="about-thread__meta">
              {credit} · {statusLabels[data.status]}
            </span>
            <strong>{shortTitle}</strong>
            <span>
              {threadNotes[project.id]} <span aria-hidden="true">→</span>
            </span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="toolkit-section" aria-labelledby="toolkit-title">
    <div class="page-shell">
      <SectionHeading id="03" headingId="toolkit-title" title="Stack" />
      <div class="toolkit-grid">
        {toolkit.map((group) => (
          <div class="toolkit-group">
            <h3>{group.label}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="leadership-section page-shell" aria-labelledby="leadership-title">
    <SectionHeading id="04" headingId="leadership-title" title="Tasveer" />
    <div class="leadership-card">
      <div>
        <p class="eyebrow">Media Society · IIIT Delhi</p>
        <h3>Event lead &amp; coordinator</h3>
      </div>
      <p>
        Outside coding, I help run Tasveer, IIIT Delhi’s media society—mostly handling event
        coordination and keeping our photo-essay website up to date.
      </p>
      <a
        class="arrow-link"
        href="https://leelanshkharbanda.github.io/tasveer/"
        target="_blank"
        rel="noreferrer noopener"
      >
        Visit Tasveer <span aria-hidden="true">↗</span>
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  </section>

  <section id="contact" class="contact-section page-shell" aria-labelledby="contact-title">
    <SectionHeading id="05" headingId="contact-title" title="Contact" />
    <ContactBlock />
  </section>
</BaseLayout>
