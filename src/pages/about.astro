---
import { getEntry } from 'astro:content';
import ContactBlock from '../components/ContactBlock.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homepageProjects } from '../data/curation';
import { requireProjectEntries } from '../data/projects';
import { evidenceLabels, roleLabels, site } from '../data/site';
import { toolkit } from '../data/toolkit';

const entries = await Promise.all(homepageProjects.map((slug) => getEntry('projects', slug)));
const threads = requireProjectEntries(homepageProjects, entries);
const threadNotes: Record<string, string> = {
  'chronos-dsp': 'geometry → simulated IQ',
  'life-os': 'local records → recommendations',
  'modulation-studio': 'source → impairment → recovery',
};
const description =
  'About Leelansh Kharbanda: ECE undergraduate at IIIT Delhi working across signal processing, computer architecture, hardware telemetry, and local-first software.';
---

<BaseLayout title="About" description={description}>
  <section class="about-hero page-shell" aria-labelledby="page-title">
    <div>
      <p class="play-kicker">{site.education} · still asking how it works</p>
      <h1 id="page-title">I like taking the lids off.</h1>
      <p class="about-hero__intro">
        My work sits between software and hardware: not because every project is a physical device,
        but because signals, memory, instructions, and telemetry all become more useful when their
        behavior can be inspected.
      </p>
    </div>
    <div class="curiosity-map" aria-hidden="true">
      <svg viewBox="0 0 520 360" role="none">
        <defs>
          <pattern id="about-map-dots" width="22" height="22" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="1.4" fill="#1d1e19" opacity="0.2" />
          </pattern>
        </defs>
        <rect width="520" height="360" fill="url(#about-map-dots)" />
        <path
          d="M 85 114 C 162 38, 218 182, 285 100 S 401 66, 449 172"
          fill="none"
          stroke="#1d1e19"
          stroke-width="3"
          stroke-dasharray="8 7"
        />
        <path
          d="M 88 117 C 159 254, 267 253, 332 250 S 406 224, 449 172"
          fill="none"
          stroke="#1d1e19"
          stroke-width="2"
        />
        <path
          d="M 280 101 C 235 169, 184 212, 88 117"
          fill="none"
          stroke="#c84627"
          stroke-width="3"
        />
        <circle cx="85" cy="114" r="38" fill="#dfff68" stroke="#1d1e19" stroke-width="3" />
        <circle cx="285" cy="100" r="45" fill="#ffdc63" stroke="#1d1e19" stroke-width="3" />
        <circle cx="449" cy="172" r="34" fill="#ff8567" stroke="#1d1e19" stroke-width="3" />
        <circle cx="88" cy="117" r="13" fill="#6072f5" stroke="#1d1e19" stroke-width="3" />
        <circle cx="332" cy="250" r="24" fill="#f6f2e7" stroke="#1d1e19" stroke-width="3" />
        <path
          d="M 70 83 l 10 -18 M 98 68 l 7 -20 M 458 220 l 18 8"
          stroke="#1d1e19"
          stroke-width="3"
          stroke-linecap="round"
        />
        <text x="85" y="120" text-anchor="middle" class="curiosity-map__text">
          ASK
        </text>
        <text x="285" y="106" text-anchor="middle" class="curiosity-map__text">
          TRACE
        </text>
        <text x="449" y="178" text-anchor="middle" class="curiosity-map__text">
          SHOW
        </text>
      </svg>
      <span class="curiosity-map__note">what changed? show me.</span>
    </div>
  </section>

  <section class="about-story page-shell" aria-labelledby="story-title">
    <SectionHeading
      id="FIELD NOTES"
      headingId="story-title"
      title="The questions keep changing. The habit doesn’t."
      intro="I try to make the mechanism visible, then leave a clear trail back to the evidence."
    />
    <div class="about-story__grid">
      <div class="prose">
        <p>
          I am Leelansh Kharbanda, a B.Tech ECE undergraduate at IIIT Delhi. My projects range from
          geometric wireless-channel simulation and browser DSP to computer-architecture
          experiments, hardware-counter research, and a local-first desktop prototype.
        </p>
        <p>
          The common thread is not a single stack. It is the question of how a hidden process
          becomes understandable. A signal path can be traced from geometry to received symbols. A
          memory system can be modeled as expert movement under a budget. An instruction can be
          followed through register and memory state. A recommendation can expose its context,
          uncertainty, and feedback.
        </p>
        <p>
          I care about the boundary around a claim as much as the claim itself. A simulation is not
          a hardware measurement. A team artifact is not sole authorship. A live URL is not proof of
          adoption. This portfolio keeps those distinctions visible and links each project back to
          source, tests, releases, reports, or demos wherever the evidence exists.
        </p>
      </div>
      <aside class="about-principles" aria-label="Working principles">
        <p class="datum-label">RULES I TAPE TO THE LID</p>
        <ol>
          <li>
            <strong>Model the system.</strong> Make assumptions and boundaries explicit.
          </li>
          <li>
            <strong>Expose the state.</strong> Let people inspect what changes and why.
          </li>
          <li>
            <strong>Show the evidence.</strong> Keep source, tests, and limits close.
          </li>
          <li>
            <strong>Credit the work.</strong> Separate individual, team, and upstream contributions.
          </li>
        </ol>
      </aside>
    </div>
  </section>

  <section class="about-threads page-shell" aria-labelledby="threads-title">
    <SectionHeading
      id="FOLLOW A THREAD"
      headingId="threads-title"
      title="Rather read the work than the About page?"
      intro="Fair enough. These three projects put the signals, states, and boundaries in concrete terms."
    />
    <div class="about-thread-grid">
      {threads.map((project) => {
        const data = project.data;
        const credit = data.creditLabel
          ? data.creditLabel
          : data.teamSize
            ? `${roleLabels[data.role]} · ${data.teamSize} people`
            : roleLabels[data.role];
        return (
          <a class="about-thread" href={`/work/${project.id}/`}>
            <span class="about-thread__meta">
              {credit} · {evidenceLabels[data.evidenceClass]}
            </span>
            <strong>{data.title}</strong>
            <span>
              {threadNotes[project.id]} <span aria-hidden="true">→</span>
            </span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="toolkit-section" aria-labelledby="toolkit-title">
    <div class="page-shell">
      <SectionHeading
        id="BOX OF BITS"
        headingId="toolkit-title"
        title="Tools I reach for."
        intro="Grouped by how they appear in the project record—not by a proficiency score."
      />
      <div class="toolkit-grid">
        {toolkit.map((group) => (
          <div class="toolkit-group">
            <h3>{group.label}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="leadership-section page-shell" aria-labelledby="leadership-title">
    <SectionHeading
      id="OFF THE BENCH"
      headingId="leadership-title"
      title="Another kind of system: people and stories."
      intro="Editorial coordination is another way to make complex work legible."
    />
    <div class="leadership-card">
      <div>
        <p class="eyebrow">Tasveer · IIIT Delhi</p>
        <h3>Coordinating a campus media archive</h3>
      </div>
      <p>
        I coordinate Tasveer, IIIT Delhi's media society. The team's editorial site brings together
        photo essays, event coverage, and the people behind the work. It is shared creative and web
        work; this portfolio links to the live site without republishing society photography.
      </p>
      <a
        class="arrow-link"
        href="https://leelanshkharbanda.github.io/tasveer/"
        target="_blank"
        rel="noreferrer noopener"
      >
        Visit Tasveer <span aria-hidden="true">↗</span>
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  </section>

  <section id="contact" class="contact-section page-shell" aria-labelledby="contact-title">
    <SectionHeading
      id="SAY HELLO"
      headingId="contact-title"
      title="Send a question worth following."
      intro="A weird behavior, a half-finished idea, or a project worth opening up together."
    />
    <ContactBlock />
  </section>
</BaseLayout>
