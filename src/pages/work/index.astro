---
import { getEntry } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { archiveProjects, featuredProjects } from '../../data/curation';
import { requireProjectEntries } from '../../data/projects';
import { site } from '../../data/site';

async function resolveProjects(slugs: readonly string[]) {
  const entries = await Promise.all(slugs.map((slug) => getEntry('projects', slug)));
  return requireProjectEntries(slugs, entries);
}

const featured = await resolveProjects(featuredProjects);
const archive = await resolveProjects(archiveProjects);
const allProjects = [...featured, ...archive];
const description =
  'Selected engineering work by Leelansh Kharbanda: wireless-channel simulation, local-first software, browser DSP, hardware-counter research, and memory-system simulation.';
---

<BaseLayout title="Work" description={description}>
  <section class="playground-page-hero page-shell" aria-labelledby="page-title">
    <div>
      <p class="play-kicker">Five projects and three earlier ones</p>
      <h1 id="page-title">Projects</h1>
      <p class="playground-page-hero__intro">
        Notes on what I built, how it works, and where the source is.
      </p>
    </div>
    <div class="project-stack" aria-hidden="true">
      <div class="project-stack__sheet">
        <span>PERSONAL SIMULATIONS</span>
        <strong>Signals, states &amp; systems</strong>
        <span>Source and limits</span>
      </div>
      <div class="project-stack__sheet">
        <span>TEAM WORK</span>
        <strong>Built with other people</strong>
        <span>Individual and team credit</span>
      </div>
      <div class="project-stack__sheet">
        <span>EARLIER PROJECTS</span>
        <strong>Some finished, some not</strong>
        <span>Still here</span>
      </div>
    </div>
  </section>

  <nav class="project-jump page-shell" aria-label="Jump to a project" data-project-jump>
    <span>Projects</span>
    {allProjects.map((project, index) => (
      <a href={`#project-${project.id}`}>
        {String(index + 1).padStart(2, '0')} / {project.data.title.split(':')[0]}
      </a>
    ))}
  </nav>

  <section class="work-section page-shell" aria-labelledby="featured-title">
    <SectionHeading
      id="DEEP DIVES"
      headingId="featured-title"
      title="Project notes"
      intro="Five projects, with notes on the mechanism, my contribution, the results, and what didn’t work."
    />
    <div class="project-list">
      {featured.map((project, index) => (
        <ProjectCard
          project={project}
          index={index}
          variant={index === 0 ? 'lead' : 'standard'}
          showVisual={true}
        />
      ))}
    </div>
  </section>

  <section class="archive-section" aria-labelledby="archive-title">
    <div class="page-shell">
      <SectionHeading
        id="SIDE DRAWER"
        headingId="archive-title"
        title="Earlier projects"
        intro="Smaller or earlier team projects, with credit and limits noted."
      />
      <div class="archive-grid">
        {archive.map((project, index) => (
          <ProjectCard
            project={project}
            index={index + featured.length}
            variant="archive"
            showVisual={false}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="work-contact page-shell" aria-labelledby="work-contact-title">
    <SectionHeading
      id="SOURCE CODE"
      headingId="work-contact-title"
      title="Source code"
      intro="The original repositories are on GitHub."
    />
    <a
      class="button button--primary"
      data-magnetic
      href={site.github}
      target="_blank"
      rel="noreferrer noopener"
    >
      Open GitHub <span aria-hidden="true">↗</span>
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
  </section>
</BaseLayout>
