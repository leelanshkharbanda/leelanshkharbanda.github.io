---
import { getEntry } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { archiveProjects, featuredProjects } from '../../data/curation';
import { requireProjectEntries } from '../../data/projects';
import { site } from '../../data/site';

async function resolveProjects(slugs: readonly string[]) {
  const entries = await Promise.all(slugs.map((slug) => getEntry('projects', slug)));
  return requireProjectEntries(slugs, entries);
}

const featured = await resolveProjects(featuredProjects);
const archive = await resolveProjects(archiveProjects);
const allProjects = [...featured, ...archive];
const description =
  'Projects by Leelansh Kharbanda: signal processing, computer architecture, hardware counters, and software.';
---

<BaseLayout title="Work" description={description} viewTransitions>
  <section class="playground-page-hero page-shell" aria-labelledby="page-title">
    <div>
      <p class="play-kicker">Work</p>
      <h1 id="page-title">Projects</h1>
      <p class="playground-page-hero__intro">
        Personal builds, research experiments, and college coursework.
      </p>
    </div>
    <div class="project-stack" aria-hidden="true">
      <div class="project-stack__sheet">
        <span>COURSEWORK</span>
        <strong>RISC-V, ERP &amp; MoE</strong>
        <span>C++ · Java · Python</span>
      </div>
      <div class="project-stack__sheet">
        <span>TEAM BUILDS</span>
        <strong>Shared repos</strong>
        <span>Tauri · JS · Python</span>
      </div>
      <div class="project-stack__sheet">
        <span>FEATURED</span>
        <strong>Signals &amp; systems</strong>
        <span>Elixir · Rust · Python</span>
      </div>
    </div>
  </section>

  <section class="work-section page-shell" aria-labelledby="featured-title">
    <nav class="project-jump" aria-label="Jump to a project" data-project-jump>
      <span>Jump to</span>
      {allProjects.map((project, index) => (
        <a href={`#project-${project.id}`}>
          {String(index + 1).padStart(2, '0')} / {project.data.title.split(':')[0]}
        </a>
      ))}
    </nav>

    <SectionHeading id="01" headingId="featured-title" title="Featured" />
    <div class="project-list">
      {featured.map((project, index) => (
        <ProjectCard
          project={project}
          index={index}
          variant={index === 0 ? 'lead' : 'standard'}
          showVisual={true}
        />
      ))}
    </div>
  </section>

  <section class="archive-section" aria-labelledby="archive-title">
    <div class="page-shell">
      <SectionHeading id="02" headingId="archive-title" title="Earlier work" />
      <div class="archive-grid">
        {archive.map((project, index) => (
          <ProjectCard
            project={project}
            index={index + featured.length}
            variant="archive"
            showVisual={false}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="work-contact page-shell" aria-labelledby="work-contact-title">
    <SectionHeading
      id="03"
      headingId="work-contact-title"
      title="GitHub"
      intro="Everything is on GitHub."
    />
    <a
      class="button button--primary"
      data-magnetic
      href={site.github}
      target="_blank"
      rel="noreferrer noopener"
    >
      Open GitHub <span aria-hidden="true">↗</span>
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
  </section>
</BaseLayout>
