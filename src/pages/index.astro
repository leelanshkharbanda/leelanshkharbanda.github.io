---
import { getEntry } from 'astro:content';
import ContactBlock from '../components/ContactBlock.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SignalToy from '../components/SignalToy.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homepageProjects } from '../data/curation';
import { requireProjectEntries } from '../data/projects';
import { site } from '../data/site';

const entries = await Promise.all(homepageProjects.map((slug) => getEntry('projects', slug)));
const projects = requireProjectEntries(homepageProjects, entries);
const quickHooks: Record<string, string> = {
  'chronos-dsp': '2D wireless channel simulator in Elixir and Rust.',
  'life-os': 'Local desktop app with SQLite, embeddings, and a contextual bandit.',
  'modulation-studio': 'Browser DSP lab for testing modulation, noise, and constellations.',
};
const description =
  'Portfolio of Leelansh Kharbanda, ECE undergrad at IIIT Delhi. Signal processing, computer architecture, hardware telemetry, and software.';
---

<BaseLayout title={site.name} description={description} viewTransitions>
  <section class="playground-hero page-shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="play-kicker">B.Tech ECE · IIIT Delhi</p>
      <h1 id="hero-title">
        <span>Hey, I’m</span>
        <span class="hero-highlight">Leelansh.</span>
      </h1>
      <p class="hero-intro">
        I’m an ECE undergrad at IIIT Delhi. I build software around signal processing, computer
        architecture, ML systems, and desktop apps.
      </p>
      <a class="hero-project-callout" href="/work/chronos-dsp/">
        <span>Latest project</span>
        <strong>Chronos-DSP — 2D wireless channel simulator</strong>
        <span>Read more →</span>
      </a>
      <div class="hero-actions">
        <a class="button button--primary" data-magnetic href="#selected-work">
          Projects <span aria-hidden="true">↓</span>
        </a>
        <a class="button button--secondary" data-magnetic href="/about/">
          About me <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="hero-toy-wrap">
      <p class="toy-sticker">drag tx or rx</p>
      <SignalToy />
    </div>
  </section>

  <nav class="playground-comparison page-shell" aria-label="Featured projects">
    {projects.map((project) => (
      <a href={`/work/${project.id}/`}>
        <span>{project.data.title.split(':')[0]}</span>
        <strong>{quickHooks[project.id] ?? project.data.summary}</strong>
      </a>
    ))}
  </nav>

  <section id="selected-work" class="work-section page-shell" aria-labelledby="work-title">
    <SectionHeading id="01" headingId="work-title" title="Projects" intro="A few recent builds." />
    <div class="project-grid">
      {projects.map((project, index) => (
        <ProjectCard
          project={project}
          index={index}
          variant={index === 0 ? 'lead' : 'standard'}
          showVisual={true}
        />
      ))}
    </div>
    <div class="section-actions">
      <a class="arrow-link" href="/work/">
        All projects <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="about-preview" aria-labelledby="about-preview-title">
    <div class="page-shell about-preview__inner">
      <SectionHeading id="02" headingId="about-preview-title" title="About" />
      <div class="about-preview__body">
        <div>
          <p>
            I’m studying ECE at IIIT Delhi (batch of 2028). Outside classes, I mostly build DSP
            tools, low-level architecture simulators, and desktop apps, and help run Tasveer, our
            campus media society.
          </p>
          <a class="arrow-link" href="/about/">
            More about me <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="theme-list" aria-label="Areas of interest">
          {site.themes.map((theme, index) => (
            <li>
              <span class="datum-label">0{index + 1}</span>
              {theme}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="contact" class="contact-section page-shell" aria-labelledby="contact-title">
    <SectionHeading id="03" headingId="contact-title" title="Contact" />
    <ContactBlock />
  </section>
</BaseLayout>
