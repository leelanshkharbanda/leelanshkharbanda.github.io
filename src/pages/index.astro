---
import { getEntry } from 'astro:content';
import ContactBlock from '../components/ContactBlock.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SignalToy from '../components/SignalToy.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homepageProjects } from '../data/curation';
import { requireProjectEntries } from '../data/projects';
import { site } from '../data/site';

const entries = await Promise.all(homepageProjects.map((slug) => getEntry('projects', slug)));
const projects = requireProjectEntries(homepageProjects, entries);
const description =
  'Leelansh Kharbanda is a B.Tech ECE student at IIIT Delhi building inspectable systems across signal processing, computer architecture, hardware telemetry, and local-first software.';
---

<BaseLayout title={site.name} description={description}>
  <section class="playground-hero page-shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="play-kicker">Hello, I’m Leelansh — welcome to my bench</p>
      <h1 id="hero-title">
        <span>I make small systems</span>
        <span class="hero-highlight">so I can see what they’re doing.</span>
      </h1>
      <p class="hero-intro">
        I’m an ECE student who likes signals, tiny instructions, and software that shows its work.
        This is where I keep the projects I’m opening up, taking apart, and learning from.
      </p>
      <a class="hero-project-callout" href="/work/chronos-dsp/">
        <span>Current experiment</span>
        <strong>Chronos-DSP: geometry → simulated IQ</strong>
        <span>See what I built →</span>
      </a>
      <div class="hero-actions">
        <a class="button button--primary" data-magnetic href="#selected-work">
          Open the project playground <span aria-hidden="true">↓</span>
        </a>
        <a class="button button--secondary" data-magnetic href="/about/">
          Meet the human <span aria-hidden="true">→</span>
        </a>
      </div>
      <nav class="hero-project-strip" aria-label="Featured projects">
        <span>Fresh from the bench</span>
        <a href="/work/chronos-dsp/">
          01 / Chronos-DSP <span aria-hidden="true">↗</span>
        </a>
        <a href="/work/life-os/">
          02 / Life OS <span aria-hidden="true">↗</span>
        </a>
        <a href="/work/modulation-studio/">
          03 / Modulation Studio <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </div>

    <div class="hero-toy-wrap">
      <p class="toy-sticker">a tiny experiment — go on, move the dots</p>
      <SignalToy />
    </div>
  </section>

  <section id="selected-work" class="work-section page-shell" aria-labelledby="work-title">
    <SectionHeading
      id="PLAY / 01"
      headingId="work-title"
      title="Things I make so I can see how they tick."
      intro="Three projects, three ways into the same habit: follow the state, keep the evidence close, and say where the model stops."
    />
    <div class="project-grid">
      {projects.map((project, index) => (
        <ProjectCard
          project={project}
          index={index}
          variant={index === 0 ? 'lead' : 'standard'}
          showVisual={true}
        />
      ))}
    </div>
    <div class="section-actions">
      <a class="arrow-link" href="/work/">
        Browse all eight project records <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="about-preview" aria-labelledby="about-preview-title">
    <div class="page-shell about-preview__inner">
      <SectionHeading
        id="PLAY / 02"
        headingId="about-preview-title"
        title="Why I keep opening the box."
        intro="Different projects, one recurring question: what changed inside the system, and how can I show you?"
      />
      <div class="about-preview__body">
        <div>
          <p>
            I’m an ECE undergraduate at IIIT Delhi. I move between signal processing, computer
            architecture, hardware-counter telemetry, and local-first software because each one
            gives me a different hidden process to trace, model, and explain.
          </p>
          <p>
            I also care about the sticky notes around a claim: who did the work, what was simulated,
            and what the evidence cannot tell us yet.
          </p>
          <a class="arrow-link" href="/about/">
            More about how I think <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="theme-list" aria-label="Recurring project themes">
          {site.themes.map((theme, index) => (
            <li>
              <span class="datum-label">0{index + 1}</span>
              {theme}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="contact" class="contact-section page-shell" aria-labelledby="contact-title">
    <SectionHeading
      id="PLAY / 03"
      headingId="contact-title"
      title="Got a strange little system question?"
      intro="I like emails that start with the problem, the weird behavior, or the thing you cannot quite explain yet."
    />
    <ContactBlock />
  </section>
</BaseLayout>
