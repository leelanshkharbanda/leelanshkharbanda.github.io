---
import { getEntry } from 'astro:content';
import ContactBlock from '../components/ContactBlock.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SignalToy from '../components/SignalToy.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homepageProjects } from '../data/curation';
import { requireProjectEntries } from '../data/projects';
import { site } from '../data/site';

const entries = await Promise.all(homepageProjects.map((slug) => getEntry('projects', slug)));
const projects = requireProjectEntries(homepageProjects, entries);
const description =
  'Projects by Leelansh Kharbanda: signal paths, computer architecture, hardware-counter experiments, and local-first tools.';
---

<BaseLayout title={site.name} description={description}>
  <section class="playground-hero page-shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="play-kicker">Hello, I’m Leelansh.</p>
      <h1 id="hero-title">
        <span>I make small systems</span>
        <span class="hero-highlight">so I can see what they’re doing.</span>
      </h1>
      <p class="hero-intro">
        I’m an ECE student at IIIT Delhi. I work on signals, computer architecture, and local-first
        software.
      </p>
      <a class="hero-project-callout" href="/work/chronos-dsp/">
        <span>Latest project</span>
        <strong>Chronos-DSP: geometry → simulated IQ</strong>
        <span>Project notes →</span>
      </a>
      <div class="hero-actions">
        <a class="button button--primary" data-magnetic href="#selected-work">
          Selected projects <span aria-hidden="true">↓</span>
        </a>
        <a class="button button--secondary" data-magnetic href="/about/">
          About me <span aria-hidden="true">→</span>
        </a>
      </div>
      <nav class="hero-project-strip" aria-label="Featured projects">
        <span>Projects</span>
        <a href="/work/chronos-dsp/">
          01 / Chronos-DSP <span aria-hidden="true">↗</span>
        </a>
        <a href="/work/life-os/">
          02 / Life OS <span aria-hidden="true">↗</span>
        </a>
        <a href="/work/modulation-studio/">
          03 / Modulation Studio <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </div>

    <div class="hero-toy-wrap">
      <p class="toy-sticker">a tiny signal sketch</p>
      <SignalToy />
    </div>
  </section>

  <nav class="playground-comparison page-shell" aria-label="Project comparison">
    {projects.map((project) => (
      <a href={`/work/${project.id}/`}>
        <span>{project.data.title.split(':')[0]}</span>
        <strong>{project.data.summary}</strong>
      </a>
    ))}
  </nav>

  <section id="selected-work" class="work-section page-shell" aria-labelledby="work-title">
    <SectionHeading
      id="PLAY / 01"
      headingId="work-title"
      title="Projects"
      intro="Recent work. Notes and source are linked."
    />
    <div class="project-grid">
      {projects.map((project, index) => (
        <ProjectCard
          project={project}
          index={index}
          variant={index === 0 ? 'lead' : 'standard'}
          showVisual={true}
        />
      ))}
    </div>
    <div class="section-actions">
      <a class="arrow-link" href="/work/">
        All projects <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="about-preview" aria-labelledby="about-preview-title">
    <div class="page-shell about-preview__inner">
      <SectionHeading id="PLAY / 02" headingId="about-preview-title" title="About me" />
      <div class="about-preview__body">
        <div>
          <p>
            I’m an ECE undergraduate at IIIT Delhi. I work on signal processing, computer
            architecture, hardware-counter telemetry, and local-first software.
          </p>
          <a class="arrow-link" href="/about/">
            More about me <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="theme-list" aria-label="Recurring project themes">
          {site.themes.map((theme, index) => (
            <li>
              <span class="datum-label">0{index + 1}</span>
              {theme}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="contact" class="contact-section page-shell" aria-labelledby="contact-title">
    <SectionHeading id="PLAY / 03" headingId="contact-title" title="Say hello." />
    <ContactBlock />
  </section>
</BaseLayout>
