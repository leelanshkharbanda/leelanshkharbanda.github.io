---
import { getEntry } from 'astro:content';
import ContactBlock from '../components/ContactBlock.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homepageProjects } from '../data/curation';
import { requireProjectEntries } from '../data/projects';
import { site } from '../data/site';

const entries = await Promise.all(homepageProjects.map((slug) => getEntry('projects', slug)));
const projects = requireProjectEntries(homepageProjects, entries);
const description =
  'Leelansh Kharbanda is a B.Tech ECE student at IIIT Delhi building inspectable systems across signal processing, computer architecture, hardware telemetry, and local-first software.';
---

<BaseLayout title={site.name} description={description}>
  <section class="hero page-shell" aria-labelledby="hero-title">
    <div class="hero__identity">
      <p class="eyebrow">{site.education}</p>
      <h1 id="hero-title">
        <span>I build inspectable systems.</span>
        <span class="hero__title-tail">Software ↔ hardware.</span>
      </h1>
      <p class="hero__intro">{site.introduction}</p>
      <div class="hero__actions">
        <a class="button button--primary" href="#selected-work">
          View selected work
        </a>
        <a class="button button--secondary" href="/resume/">
          Résumé
        </a>
      </div>
    </div>

    <section class="proof-strip" aria-label="Portfolio evidence summary">
      <div class="proof-strip__item">
        <span class="datum-label">D-01</span>
        <p class="proof-strip__label">Question</p>
        <p>Can technical behavior become inspectable?</p>
      </div>
      <div class="proof-strip__item">
        <span class="datum-label">D-02</span>
        <p class="proof-strip__label">Artifact</p>
        <p>Five case studies and three archive records, linked to source evidence.</p>
      </div>
      <div class="proof-strip__item">
        <span class="datum-label">D-03</span>
        <p class="proof-strip__label">Evidence class</p>
        <p>Source, tests, releases, live demos, simulations, and explicit limits.</p>
      </div>
    </section>
  </section>

  <section id="selected-work" class="work-section page-shell" aria-labelledby="work-title">
    <SectionHeading
      id="S-01"
      headingId="work-title"
      title="Selected work"
      intro="Three complementary systems: a wireless-channel simulation, a local-first desktop prototype, and a browser signal lab."
    />
    <div class="project-grid">
      {projects.map((project, index) => (
        <ProjectCard
          project={project}
          index={index}
          variant={index === 0 ? 'lead' : 'standard'}
          showVisual={true}
        />
      ))}
    </div>
    <div class="section-actions">
      <a class="arrow-link" href="/work/">
        Explore all work <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="about-preview" aria-labelledby="about-preview-title">
    <div class="page-shell about-preview__inner">
      <SectionHeading
        id="S-02"
        headingId="about-preview-title"
        title="The recurring questions"
        intro="Different projects, one habit: make the mechanism visible and keep the evidence close."
      />
      <div class="about-preview__body">
        <div>
          <p>
            I am an ECE undergraduate at IIIT Delhi. My work moves between signal processing,
            computer architecture, hardware-counter telemetry, and local-first software—not because
            the domains are interchangeable, but because each asks how a hidden process can be
            observed, modeled, and explained.
          </p>
          <a class="arrow-link" href="/about/">
            More about my approach <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="theme-list">
          {site.themes.map((theme, index) => (
            <li>
              <span class="datum-label">0{index + 1}</span>
              {theme}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="contact" class="contact-section page-shell" aria-labelledby="contact-title">
    <SectionHeading
      id="S-03"
      headingId="contact-title"
      title="Have a system worth understanding?"
      intro="Email about a relevant role, research question, or project collaboration."
    />
    <ContactBlock />
  </section>
</BaseLayout>
